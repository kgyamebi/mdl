# Quick LAN dev example — copy to project root as .env
# Used by docker-compose; frontend reads frontend/.env.development

DB_HOST=localhost
DB_PORT=3306
DB_NAME=mdl_platform
DB_USER=mdl_user
DB_PASSWORD=change_me_in_production

SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

JWT_SECRET=change_this_to_a_long_random_secret_at_least_256_bits
CORS_ALLOW_LAN_ORIGINS=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.21:5173

VITE_API_BASE_URL=http://192.168.100.21:8080
VITE_BACKEND_URL=http://127.0.0.1:8080

OWNER_SEED_ENABLED=true
DEMO_SEED_ENABLED=true
