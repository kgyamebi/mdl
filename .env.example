# =============================================================================
# MDL Platform — Environment Variables
# Copy this file to .env and fill in values. Never commit .env to Git.
# =============================================================================

# --- Database (MariaDB) ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mdl_platform
DB_USER=mdl_user
DB_PASSWORD=change_me_in_production

# --- Backend ---
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Use prod profile in deployment:
# SPRING_PROFILES_ACTIVE=prod
# OWNER_SEED_ENABLED=false
# DEMO_SEED_ENABLED=false

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_secret_at_least_256_bits
JWT_ACCESS_TOKEN_EXPIRY_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRY_DAYS=7

# --- MDL Owner (first startup seed) ---
OWNER_SEED_ENABLED=true
OWNER_EMAIL=owner@mdl.local
OWNER_USERNAME=owner
OWNER_PASSWORD=Owner@123!

# --- Demo employees (John shop worker, Michael shop manager) ---
DEMO_SEED_ENABLED=true

# --- CORS (comma-separated origins for production) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- File uploads ---
FILE_UPLOAD_MAX_SIZE_MB=10
FILE_STORAGE_PATH=./storage

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8080
