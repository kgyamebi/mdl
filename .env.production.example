# =============================================================================
# MDL Platform — Production VPS (.env)
# Copy to .env on your server:  cp .env.production.example .env
# Never commit .env to Git.
# =============================================================================

# --- Public URL (required for HTTPS) ---
# Point an A record at your VPS IP before first deploy.
DOMAIN=app.example.com
LETSENCRYPT_EMAIL=admin@example.com

# --- Database ---
DB_NAME=mdl_platform
DB_USER=mdl_user
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- JWT (min 32 chars; generate with: openssl rand -base64 48) ---
JWT_SECRET=

# --- CORS (optional — defaults to https://${DOMAIN} in docker-compose.prod.yml) ---
# CORS_ALLOWED_ORIGINS=https://app.example.com

# --- Owner account (created on first boot if missing) ---
OWNER_SEED_ENABLED=true
OWNER_EMAIL=owner@yourcompany.com
OWNER_USERNAME=owner
OWNER_PASSWORD=

# After first login, set OWNER_SEED_ENABLED=false and redeploy:
#   docker compose -f docker-compose.prod.yml up -d
