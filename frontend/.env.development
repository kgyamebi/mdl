# MDL Frontend — development (LAN + mobile testing)
# Copy to .env.development.local to override.

# Leave empty to auto-detect:
#   localhost → Vite proxy (http://127.0.0.1:8080)
#   192.168.x.x → direct API (http://192.168.x.x:8080)
VITE_API_BASE_URL=

# Optional alias: VITE_API_URL=

# Backend port for auto LAN detection
VITE_API_PORT=8080

# Vite dev-server proxy target (desktop)
VITE_BACKEND_URL=http://127.0.0.1:8080
